{
  "name": "sheetstamp",
  "version": "0.1.0",
  "description": "Fill Word and image templates from CSV or Excel files, offline.",
  "homepage": "https://github.com/nhhthong/sheetstamp",
  "license": "MIT",
  "author": "nhhthong",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:e2e": "electron-vite build --mode e2e",
    "preview": "electron-vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "bench": "node scripts/bench.mjs --write",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "iconv-lite": "^0.7.3",
    "konva": "10.8.0",
    "lucide-react": "^1.63.0",
    "pe-library": "0.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "19.3.2",
    "resedit": "1.7.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "archiver": "^8.0.0",
    "easy-template-x": "^8.0.0",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.5.0",
    "jszip": "^3.10.2",
    "papaparse": "^5.7.0",
    "ssf": "^0.11.2"
  },
  "sheetstamp": {
    "bundledDevDependencies": [
      "react",
      "react-dom",
      "@base-ui/react",
      "lucide-react",
      "class-variance-authority",
      "clsx",
      "tailwind-merge",
      "docx-preview",
      "react-konva",
      "konva"
    ]
  }
}
